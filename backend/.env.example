# Backend Environment Configuration
PORT=5000

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartcampus?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Frontend Application URL (for CORS allowed origins)
CLIENT_URL=http://localhost:3000
